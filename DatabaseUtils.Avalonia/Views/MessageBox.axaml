<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DatabaseUtils.Avalonia.Views.MessageBox"
        Title="提示" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16" Spacing="12" MinWidth="320">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="确定" MinWidth="80" Click="OnOk" />
      <Button x:Name="CancelButton" Content="取消" MinWidth="80" Click="OnCancel" IsVisible="False" />
    </StackPanel>
  </StackPanel>
</Window>
