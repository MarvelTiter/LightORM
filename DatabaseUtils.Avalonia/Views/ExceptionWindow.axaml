<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DatabaseUtils.Avalonia.Views.ExceptionWindow"
        Title="发生异常" Width="620" Height="420" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="异常类型:" FontWeight="Medium" />
        <TextBlock x:Name="ExceptionTypeText" FontWeight="Medium" />
      </StackPanel>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontWeight="Medium" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CopyButton" Content="复制详情" MinWidth="80" Click="OnCopy" />
      <Button Content="关闭" MinWidth="80" Click="OnClose" />
    </StackPanel>
    <ScrollViewer Margin="0,12,0,0">
      <TextBlock x:Name="DetailText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
    </ScrollViewer>
  </DockPanel>
</Window>
