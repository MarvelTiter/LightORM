<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DatabaseUtils.Avalonia.ViewModels"
        x:Class="DatabaseUtils.Avalonia.Views.AttributeSettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="属性自定义Attribute配置" Width="550" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="属性自定义Attribute配置" FontWeight="Medium" />
    <TextBlock Text="{}{0} 占位符用于填充 Comment 属性" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    <ItemsControl ItemsSource="{Binding ExternalAttributes}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AttributeItemViewModel">
          <TextBox Margin="0,2" Text="{Binding Value}"
                   PlaceholderText='[自定义Attribute(Comment = "{0}")]' />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
      <Button Content="添加" MinWidth="80" Command="{Binding AddAttributeCommand}" />
      <Button Content="清空" MinWidth="80" Command="{Binding ClearAttributesCommand}" />
      <Button Content="关闭" MinWidth="80" HorizontalAlignment="Right" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</Window>
